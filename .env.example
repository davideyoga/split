# Copia questo file in `.env` (nella root del repo) e sostituisci i valori.
# `.env` è gitignored: i valori reali non devono mai finire nel repository.
# In produzione non si usa un file .env: le variabili si impostano nel pannello
# dell'hosting (Railway/Render/container/…).

# Connessione al database Postgres di sviluppo.
# Utente e database si creano come descritto in CLAUDE.md ("Environment setup").
DATABASE_URL="postgresql://admin:LA_TUA_PASSWORD@localhost:5432/split-db"

# Facoltativo: database dei test e2e (splitFront-e2e). Se manca si usa lo stesso
# server di DATABASE_URL con il database "split-db-e2e". Viene SVUOTATO a ogni
# esecuzione dei test, e il nome deve finire con "-e2e" (vedi doc/Playwright.md).
# E2E_DATABASE_URL="postgresql://admin:LA_TUA_PASSWORD@localhost:5432/split-db-e2e"

# Chiave con cui l'API firma i token JWT del login (AuthModule).
# Stringa casuale lunga; chi la conosce può forgiare token per qualsiasi utente.
# Generane una con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="stringa_casuale_lunga_a_tua_scelta"
