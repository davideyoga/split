generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

model User {
  id                   Int                @id @default(autoincrement())
  email                String             @unique
  publicId             String             @unique @default(uuid())
  nickName             String             @unique
  expenseContributions ExpenseContribution[]
  expensesCreatedByMe  Expense[]          @relation("CreatedBy")
  expensesPaidByMe     Expense[]          @relation("PaidBy")
  userOnGroups         UserOnGroup[]
  createdDate          DateTime           @default(now())
  confirmed            Boolean            @default(false)
  confirmationCodes    ConfirmationCode[]
  refreshToken         String?
}

model ConfirmationCode {
  id        Int      @id @default(autoincrement())
  code      String
  user      User     @relation(fields: [userId], references: [id])
  userId    Int
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model ExpenseContribution {

  id          Int      @id @default(autoincrement())
  user        User     @relation(fields: [userId], references: [id])
  userId      Int
  expense     Expense  @relation(fields: [expenseId], references: [id])
  expenseId   Int
  share       Decimal  // Quanto deve questa persona per questa spesa
  createdDate DateTime @default(now())
}

model Expense {

  id                   Int                   @id @default(autoincrement())
  amount               Decimal
  currency             String                @default("EUR") // Pronto per V2.0
  category             String?               // Pronto per V3.0
  createdDate          DateTime              @default(now())
  expenseContributions ExpenseContribution[]
  createdBy            User                  @relation("CreatedBy", fields: [createdById], references: [id])
  createdById          Int
  group                Group?                @relation(fields: [groupId], references: [id])
  groupId              Int?
  description          String
  paidBy               User                  @relation("PaidBy", fields: [paidById], references: [id])
  paidById             Int
}

model Group {
  id              Int              @id() @default(autoincrement())
  name            String
  usersOnGroup    UserOnGroup[]
  expenses        Expense[]
  createdDate     DateTime         @default(now())
}

model UserOnGroup {
  id          Int      @id() @default(autoincrement())
  groupId     Int
  group       Group    @relation(fields: [groupId], references: [id])
  userId      Int
  user        User     @relation(fields: [userId], references: [id])
  createdDate DateTime @default(now())
}