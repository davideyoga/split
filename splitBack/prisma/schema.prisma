generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

model User {
  id                   Int                @id @default(autoincrement())
  email                String             @unique
  publicId             String             @unique @default(uuid())
  nickName             String             @unique
  expenseContributions ExpenseContribution[]
  expensesCreatedByMe  Expense[]          @relation("CreatedBy")
  userOnGroups         UserOnGroup[]
  createdDate          DateTime           @default(now())
  confirmed            Boolean            @default(false)
  confirmationCodes    ConfirmationCode[]
  refreshToken         String?
}

model ConfirmationCode {
  id        Int      @id @default(autoincrement())
  code      String
  user      User     @relation(fields: [userId], references: [id])
  userId    Int
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model ExpenseContribution {

  id          Int      @id @default(autoincrement())
  user        User     @relation(fields: [userId], references: [id])
  userId      Int
  expense     Expense  @relation(fields: [expenseId], references: [id])
  expenseId   Int
  createdDate DateTime @default(now())
}

model Expense {

  id                   Int                   @id @default(autoincrement())
  amount               Decimal
  createdDate          DateTime              @default(now())
  expenseContributions ExpenseContribution[]
  createdBy            User                  @relation("CreatedBy", fields: [createdById], references: [id])
  createdById          Int
  groupsOnExpenses     ExpenseOnGroup[]
  description          String
}

model Group {
  id              Int              @id() @default(autoincrement())
  name            String
  usersOnGroup    UserOnGroup[]
  expensesOnGroup ExpenseOnGroup[]
  createdDate     DateTime         @default(now())
}

model UserOnGroup {
  id          Int      @id() @default(autoincrement())
  groupId     Int
  group       Group    @relation(fields: [groupId], references: [id])
  userId      Int
  user        User     @relation(fields: [userId], references: [id])
  createdDate DateTime @default(now())
}

model ExpenseOnGroup {

  id          Int      @id() @default(autoincrement())
  expenseId   Int
  expense     Expense  @relation(fields: [expenseId], references: [id])
  groupId     Int
  group       Group    @relation(fields: [groupId], references: [id])
  createdDate DateTime @default(now())
}
