generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// E' anche la tabella `user` di Better Auth (splitBack/src/app/auth/auth.factory.ts),
// che ne rimappa i campi: name -> nickName, emailVerified -> confirmed,
// createdAt -> createdDate. `image` e `updatedAt` esistono solo per Better Auth.
model User {
  id                   Int                   @id @default(autoincrement())
  email                String                @unique
  publicId             String                @unique @default(uuid())
  // citext: @unique ignora maiuscole/minuscole. Regole del nickname in
  // splitBack/src/app/user/nickname.ts.
  nickName             String                @unique @db.Citext
  expenseContributions ExpenseContribution[] @relation("ContributionUser")
  expensesCreatedByMe  Expense[]             @relation("CreatedBy")
  expensesPaidByMe     Expense[]             @relation("PaidBy")
  userOnGroups         UserOnGroup[]         @relation("MembershipUser")
  categories           Category[]
  settlementsPaid      Settlement[]          @relation("SettlementFrom")
  settlementsReceived  Settlement[]          @relation("SettlementTo")
  settlementsCreated   Settlement[]          @relation("SettlementCreatedBy")
  createdDate          DateTime              @default(now())
  updatedAt            DateTime              @default(now()) @updatedAt
  confirmed            Boolean               @default(false)
  // Registrato da solo (codice via email, Google o Apple) e non ha ancora
  // scelto il nickname: ne ha uno provvisorio e l'app lo manda su /welcome.
  // Torna false con PATCH /api/user/me. Chi viene da seed/add-users ha gia' il suo.
  needsName            Boolean               @default(false)
  image                String?
  sessions             Session[]
  accounts             Account[]
  notifications        Notification[]        @relation("NotificationRecipient")
  notificationsCaused  Notification[]        @relation("NotificationActor")
  groupInvites         GroupInvite[]
  blocks               UserBlock[]           @relation("Blocker")
  blockedBy            UserBlock[]           @relation("Blocked")
}

// Tabelle di Better Auth (login con codice via email). Gli id sono interi
// autoincrement come quelli di User (`advanced.database.generateId: "serial"`).

// Una sessione per dispositivo: `token` e' il Bearer che il frontend manda.
model Session {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// Account collegati (provider social, password). Col solo login via codice
// resta vuota, ma Better Auth la richiede.
model Account {
  id                    Int       @id @default(autoincrement())
  accountId             String
  providerId            String
  userId                Int
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
}

// Codici di login in attesa (salvati come hash, scadono dopo 10 minuti).
model Verification {
  id         Int      @id @default(autoincrement())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@index([identifier])
}

model ExpenseContribution {
  id          Int      @id @default(autoincrement())
  user        User     @relation("ContributionUser", fields: [userId], references: [id])
  userId      Int
  expense     Expense  @relation(fields: [expenseId], references: [id])
  expenseId   Int
  share       Decimal // Quanto deve questa persona per questa spesa
  createdDate DateTime @default(now())
}

model Expense {
  id                   Int                   @id @default(autoincrement())
  publicId             String                @unique @default(uuid())
  amount               Decimal
  currency             String                @default("EUR") // Pronto per V2.0
  category             Category?             @relation(fields: [categoryId], references: [id])
  categoryId           Int?
  // Quando il record e' stato inserito: lo scrive il DB, non si modifica e
  // non si mostra (serve solo a ordinare le spese dello stesso giorno).
  createdDate          DateTime              @default(now())
  // Giorno della spesa, scelto dall'utente (solo data, senza ora ne' fuso).
  // Il frontend lo manda sempre, col "oggi" del dispositivo; il default
  // CURRENT_DATE (fuso del server) vale solo per chi lo omette.
  date                 DateTime              @default(dbgenerated("CURRENT_DATE")) @db.Date
  expenseContributions ExpenseContribution[]
  createdBy            User                  @relation("CreatedBy", fields: [createdById], references: [id])
  createdById          Int
  group                Group?                @relation(fields: [groupId], references: [id])
  groupId              Int?
  description          String
  paidBy               User                  @relation("PaidBy", fields: [paidById], references: [id])
  paidById             Int
  notifications        Notification[]
}

// Rimborso fra due utenti: `from` da' `amount` a `to`. Non appartiene a nessun
// gruppo (decisione di prodotto, 2026-09-26: i gruppi servono solo a non
// reinserire sempre le stesse persone), quindi azzera il saldo complessivo fra
// i due, non quello di un gruppo. Lo puo' registrare ed eliminare uno qualsiasi
// dei due.
model Settlement {
  id            Int            @id @default(autoincrement())
  publicId      String         @unique @default(uuid())
  from          User           @relation("SettlementFrom", fields: [fromId], references: [id])
  fromId        Int
  to            User           @relation("SettlementTo", fields: [toId], references: [id])
  toId          Int
  amount        Decimal
  currency      String         @default("EUR") // Pronto per V2.0
  note          String?
  createdBy     User           @relation("SettlementCreatedBy", fields: [createdById], references: [id])
  createdById   Int
  createdDate   DateTime       @default(now())
  notifications Notification[]

  @@index([fromId])
  @@index([toId])
}

model Group {
  id            Int            @id() @default(autoincrement())
  publicId      String         @unique @default(uuid())
  name          String
  usersOnGroup  UserOnGroup[]
  expenses      Expense[]
  createdDate   DateTime       @default(now())
  notifications Notification[]
  invites       GroupInvite[]
}

// Categorie delle spese. ownerId null = categoria preconfigurata di sistema,
// visibile a tutti; ownerId valorizzato = categoria custom di quell'utente.
// Le preconfigurate si identificano con lo slug (tradotto dal frontend via
// `categories.<slug>`), le custom con il name libero.
model Category {
  id          Int       @id @default(autoincrement())
  publicId    String    @unique @default(uuid())
  slug        String?   @unique // solo per le preconfigurate; garantisce che non ci siano globali duplicate
  name        String? // solo per quelle utente
  icon        String    @default("pricetag-outline") // nome ionicon
  color       String?
  owner       User?     @relation(fields: [ownerId], references: [id])
  ownerId     Int?
  archived    Boolean   @default(false) // cancellazione soft: le spese storiche restano valide
  createdDate DateTime  @default(now())
  expenses    Expense[]

  @@unique([ownerId, name])
}

model UserOnGroup {
  id          Int          @id() @default(autoincrement())
  groupId     Int
  group       Group        @relation(fields: [groupId], references: [id])
  userId      Int
  user        User         @relation("MembershipUser", fields: [userId], references: [id])
  createdDate DateTime     @default(now())
  // Il link con cui e' entrato (2026-11-07): audit minimo. null = creatore del
  // gruppo, o membro aggiunto prima dei link.
  invite      GroupInvite? @relation(fields: [inviteId], references: [id], onDelete: SetNull)
  inviteId    Int?

  @@unique([groupId, userId])
}

// Link d'invito a un gruppo (2026-11-07, doc/InvitiGruppo.md): nei gruppi si
// entra solo cosi'. Del token si salva solo lo SHA-256, come per i codici di
// login. Un solo link attivo per gruppo: crearne uno revoca i precedenti, che
// restano per l'audit.
model GroupInvite {
  id          Int           @id @default(autoincrement())
  group       Group         @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupId     Int
  tokenHash   String        @unique
  createdBy   User          @relation(fields: [createdById], references: [id])
  createdById Int
  createdDate DateTime      @default(now())
  expiresAt   DateTime
  revokedAt   DateTime?
  members     UserOnGroup[]

  @@index([groupId])
}

// Notifica per un utente (2026-10-25): un messaggio su qualcosa che un altro ha
// fatto e che lo riguarda, non lo stato di una richiesta (quello, per amicizie
// e spese in attesa, stara' nelle loro tabelle). Niente testo generato: il
// frontend traduce `notifications.type.<type>` nella lingua di chi legge, coi
// dati delle relazioni. Si crea solo da NotificationService.notify(), nella
// stessa transazione dell'azione: li' si aggancera' anche la push.
model Notification {
  id           Int         @id @default(autoincrement())
  publicId     String      @unique @default(uuid())
  // Destinatario.
  user         User        @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  userId       Int
  // EXPENSE_ADDED, GROUP_ADDED, ... (notification.types.ts). Stringa e non
  // enum Postgres: un tipo nuovo non chiede una migrazione.
  type         String
  // Chi ha fatto l'azione.
  actor        User?       @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)
  actorId      Int?
  // Cascade: una notifica non mostra mai una spesa, un gruppo o un rimborso
  // che non esistono piu'.
  expense      Expense?    @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  expenseId    Int?
  group        Group?      @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupId      Int?
  settlement   Settlement? @relation(fields: [settlementId], references: [id], onDelete: Cascade)
  settlementId Int?
  // Istantanea di una spesa eliminata o da cui si e' stati tolti:
  // { description, amount, currency, categorySlug }. Solo dati e testo scritto
  // dagli utenti.
  params       Json?
  readAt       DateTime?
  createdDate  DateTime    @default(now())

  @@index([userId, createdDate])
  @@index([userId, readAt])
}

// "Blocca" (2026-11-07, doc/InvitiGruppo.md): `blocked` non trova piu' `blocker`
// con la ricerca ne' fra i contatti, non puo' aggiungerlo a nuove spese ne'
// registrare rimborsi con lui, e le sue azioni non gli mandano notifiche. Le
// spese e i gruppi gia' in comune restano: i saldi sono debiti veri.
model UserBlock {
  id          Int      @id @default(autoincrement())
  blocker     User     @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blockerId   Int
  blocked     User     @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)
  blockedId   Int
  createdDate DateTime @default(now())

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}
