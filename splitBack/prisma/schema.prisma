generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

// E' anche la tabella `user` di Better Auth (splitBack/src/app/auth/auth.factory.ts),
// che ne rimappa i campi: name -> nickName, emailVerified -> confirmed,
// createdAt -> createdDate. `image` e `updatedAt` esistono solo per Better Auth.
model User {
  id                   Int                @id @default(autoincrement())
  email                String             @unique
  publicId             String             @unique @default(uuid())
  // citext: @unique ignora maiuscole/minuscole. Regole del nickname in
  // splitBack/src/app/user/nickname.ts.
  nickName             String             @unique @db.Citext
  expenseContributions ExpenseContribution[] @relation("ContributionUser")
  expensesCreatedByMe  Expense[]          @relation("CreatedBy")
  expensesPaidByMe     Expense[]          @relation("PaidBy")
  userOnGroups         UserOnGroup[]      @relation("MembershipUser")
  categories           Category[]
  settlementsPaid      Settlement[]       @relation("SettlementFrom")
  settlementsReceived  Settlement[]       @relation("SettlementTo")
  settlementsCreated   Settlement[]       @relation("SettlementCreatedBy")
  createdDate          DateTime           @default(now())
  updatedAt            DateTime           @default(now()) @updatedAt
  confirmed            Boolean            @default(false)
  image                String?
  sessions             Session[]
  accounts             Account[]
  notifications        Notification[]     @relation("NotificationRecipient")
  notificationsCaused  Notification[]     @relation("NotificationActor")
  friendshipsA         Friendship[]       @relation("FriendshipA")
  friendshipsB         Friendship[]       @relation("FriendshipB")
  contributionsInvited ExpenseContribution[] @relation("ContributionInvitedBy")
  membershipsInvited   UserOnGroup[]      @relation("MembershipInvitedBy")
}

// Tabelle di Better Auth (login con codice via email). Gli id sono interi
// autoincrement come quelli di User (`advanced.database.generateId: "serial"`).

// Una sessione per dispositivo: `token` e' il Bearer che il frontend manda.
model Session {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// Account collegati (provider social, password). Col solo login via codice
// resta vuota, ma Better Auth la richiede.
model Account {
  id                    Int       @id @default(autoincrement())
  accountId             String
  providerId            String
  userId                Int
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
}

// Codici di login in attesa (salvati come hash, scadono dopo 10 minuti).
model Verification {
  id         Int      @id @default(autoincrement())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@index([identifier])
}

model ExpenseContribution {

  id          Int      @id @default(autoincrement())
  user        User     @relation("ContributionUser", fields: [userId], references: [id])
  userId      Int
  expense     Expense  @relation(fields: [expenseId], references: [id])
  expenseId   Int
  share       Decimal  // Quanto deve questa persona per questa spesa
  createdDate DateTime @default(now())
  // In attesa (2026-10-25): l'ha aggiunto `invitedBy`, che non e' (ancora) suo
  // amico. Finche' non accetta, la spesa non conta per lui (saldi, spese del
  // mese); per tutti gli altri si'. Diventano amici -> pending = false.
  pending     Boolean  @default(false)
  invitedBy   User?    @relation("ContributionInvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)
  invitedById Int?
}

model Expense {

  id                   Int                   @id @default(autoincrement())
  publicId             String                @unique @default(uuid())
  amount               Decimal
  currency             String                @default("EUR") // Pronto per V2.0
  category             Category?             @relation(fields: [categoryId], references: [id])
  categoryId           Int?
  // Quando il record e' stato inserito: lo scrive il DB, non si modifica e
  // non si mostra (serve solo a ordinare le spese dello stesso giorno).
  createdDate          DateTime              @default(now())
  // Giorno della spesa, scelto dall'utente (solo data, senza ora ne' fuso).
  // Il frontend lo manda sempre, col "oggi" del dispositivo; il default
  // CURRENT_DATE (fuso del server) vale solo per chi lo omette.
  date                 DateTime              @default(dbgenerated("CURRENT_DATE")) @db.Date
  expenseContributions ExpenseContribution[]
  createdBy            User                  @relation("CreatedBy", fields: [createdById], references: [id])
  createdById          Int
  group                Group?                @relation(fields: [groupId], references: [id])
  groupId              Int?
  description          String
  paidBy               User                  @relation("PaidBy", fields: [paidById], references: [id])
  paidById             Int
  notifications        Notification[]
}

// Rimborso fra due utenti: `from` da' `amount` a `to`. Non appartiene a nessun
// gruppo (decisione di prodotto, 2026-09-26: i gruppi servono solo a non
// reinserire sempre le stesse persone), quindi azzera il saldo complessivo fra
// i due, non quello di un gruppo. Lo puo' registrare ed eliminare uno qualsiasi
// dei due.
model Settlement {
  id          Int      @id @default(autoincrement())
  publicId    String   @unique @default(uuid())
  from        User     @relation("SettlementFrom", fields: [fromId], references: [id])
  fromId      Int
  to          User     @relation("SettlementTo", fields: [toId], references: [id])
  toId        Int
  amount      Decimal
  currency    String   @default("EUR") // Pronto per V2.0
  note        String?
  createdBy   User     @relation("SettlementCreatedBy", fields: [createdById], references: [id])
  createdById Int
  createdDate DateTime @default(now())
  notifications Notification[]

  @@index([fromId])
  @@index([toId])
}

model Group {
  id              Int              @id() @default(autoincrement())
  publicId        String           @unique @default(uuid())
  name            String
  usersOnGroup    UserOnGroup[]
  expenses        Expense[]
  createdDate     DateTime         @default(now())
  notifications   Notification[]
}

// Categorie delle spese. ownerId null = categoria preconfigurata di sistema,
// visibile a tutti; ownerId valorizzato = categoria custom di quell'utente.
// Le preconfigurate si identificano con lo slug (tradotto dal frontend via
// `categories.<slug>`), le custom con il name libero.
model Category {
  id          Int       @id @default(autoincrement())
  publicId    String    @unique @default(uuid())
  slug        String?   @unique // solo per le preconfigurate; garantisce che non ci siano globali duplicate
  name        String?   // solo per quelle utente
  icon        String    @default("pricetag-outline") // nome ionicon
  color       String?
  owner       User?     @relation(fields: [ownerId], references: [id])
  ownerId     Int?
  archived    Boolean   @default(false) // cancellazione soft: le spese storiche restano valide
  createdDate DateTime  @default(now())
  expenses    Expense[]

  @@unique([ownerId, name])
}

model UserOnGroup {
  id          Int      @id() @default(autoincrement())
  groupId     Int
  group       Group    @relation(fields: [groupId], references: [id])
  userId      Int
  user        User     @relation("MembershipUser", fields: [userId], references: [id])
  createdDate DateTime @default(now())
  // Invito in attesa (2026-10-25): l'ha aggiunto `invitedBy`, che non era suo
  // amico. Finche' non accetta non e' un membro: non vede il gruppo e non entra
  // nelle sue spese.
  pending     Boolean  @default(false)
  invitedBy   User?    @relation("MembershipInvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)
  invitedById Int?

  @@unique([groupId, userId])
}

// Notifica per un utente (2026-10-25): un messaggio su qualcosa che un altro ha
// fatto e che lo riguarda, non lo stato di una richiesta (quello, per amicizie
// e spese in attesa, stara' nelle loro tabelle). Niente testo generato: il
// frontend traduce `notifications.type.<type>` nella lingua di chi legge, coi
// dati delle relazioni. Si crea solo da NotificationService.notify(), nella
// stessa transazione dell'azione: li' si aggancera' anche la push.
model Notification {
  id           Int         @id @default(autoincrement())
  publicId     String      @unique @default(uuid())
  // Destinatario.
  user         User        @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  userId       Int
  // EXPENSE_ADDED, GROUP_ADDED, ... (notification.types.ts). Stringa e non
  // enum Postgres: un tipo nuovo non chiede una migrazione.
  type         String
  // Chi ha fatto l'azione.
  actor        User?       @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)
  actorId      Int?
  // Cascade: una notifica non mostra mai una spesa, un gruppo o un rimborso
  // che non esistono piu'.
  expense      Expense?    @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  expenseId    Int?
  group        Group?      @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupId      Int?
  settlement   Settlement? @relation(fields: [settlementId], references: [id], onDelete: Cascade)
  settlementId Int?
  // Istantanea di una spesa eliminata o da cui si e' stati tolti:
  // { description, amount, currency, categorySlug }. Solo dati e testo scritto
  // dagli utenti.
  params       Json?
  readAt       DateTime?
  createdDate  DateTime    @default(now())

  @@index([userId, createdDate])
  @@index([userId, readAt])
}

// Amicizia (2026-10-25): esiste solo se accettata. Le richieste non hanno una
// tabella: sono le quote di spesa e gli inviti ai gruppi in attesa
// (ExpenseContribution.pending, UserOnGroup.pending). Coppia non ordinata
// salvata una volta sola, con userAId < userBId (CHECK nella migrazione).
model Friendship {
  id          Int      @id @default(autoincrement())
  userA       User     @relation("FriendshipA", fields: [userAId], references: [id], onDelete: Cascade)
  userAId     Int
  userB       User     @relation("FriendshipB", fields: [userBId], references: [id], onDelete: Cascade)
  userBId     Int
  createdDate DateTime @default(now())

  @@unique([userAId, userBId])
  @@index([userBId])
}
