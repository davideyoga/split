{
  "name": "splitFront",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "app",
  "sourceRoot": "splitFront/src",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/splitFront",
        "browser": "splitFront/src/main.ts",
        "polyfills": ["zone.js"],
        "tsConfig": "splitFront/tsconfig.app.json",
        "inlineStyleLanguage": "scss",
        "assets": [
          {
            "glob": "**/*.svg",
            "input": "node_modules/ionicons/dist/ionicons/svg",
            "output": "./svg"
          },
          {
            "glob": "**/*",
            "input": "splitFront/src/assets",
            "output": "assets"
          },
          {
            "glob": "**/*",
            "input": "splitFront/src/public",
            "output": "."
          }
        ],
        "styles": [
          "splitFront/src/styles.scss",
          "splitFront/src/theme/variables.scss",
          "node_modules/@ionic/angular/css/core.css",
          "node_modules/@ionic/angular/css/normalize.css",
          "node_modules/@ionic/angular/css/structure.css",
          "node_modules/@ionic/angular/css/typography.css",
          "node_modules/@ionic/angular/css/display.css",
          "node_modules/@ionic/angular/css/padding.css",
          "node_modules/@ionic/angular/css/float-elements.css",
          "node_modules/@ionic/angular/css/text-alignment.css",
          "node_modules/@ionic/angular/css/text-transformation.css",
          "node_modules/@ionic/angular/css/flex-utils.css",
          "node_modules/@ionic/angular/css/palettes/dark.system.css"
        ]
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "1mb",
              "maximumError": "2mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "4kb",
              "maximumError": "8kb"
            }
          ],
          "outputHashing": "all",
          "serviceWorker": "splitFront/ngsw-config.json",
          "fileReplacements": [
            {
              "replace": "splitFront/src/environments/environment.ts",
              "with": "splitFront/src/environments/environment.prod.ts"
            }
          ]
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        },
        "e2e": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true,
          "fileReplacements": [
            {
              "replace": "splitFront/src/environments/environment.ts",
              "with": "splitFront/src/environments/environment.e2e.ts"
            }
          ]
        }
      },
      "defaultConfiguration": "production"
    },
    "serve": {
      "continuous": true,
      "executor": "@angular/build:dev-server",
      "configurations": {
        "production": {
          "buildTarget": "splitFront:build:production"
        },
        "development": {
          "buildTarget": "splitFront:build:development"
        },
        "e2e": {
          "buildTarget": "splitFront:build:e2e",
          "port": 4300
        }
      },
      "defaultConfiguration": "development"
    },
    "extract-i18n": {
      "executor": "@angular/build:extract-i18n",
      "options": {
        "buildTarget": "splitFront:build"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "serve-static": {
      "continuous": true,
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "splitFront:build",
        "staticFilePath": "dist/splitFront/browser",
        "spa": true
      }
    }
  }
}
